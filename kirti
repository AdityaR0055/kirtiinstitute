<!DOCTYPE html>
<html lang="mr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>किर्ती कॉम्प्युटर टायपिंग अँड शॉर्टहँड इन्स्टिट्यूट</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #34ebf5f5;
            --accent-color: #FF9900;
            --bg-light: #F4F7F6;
            --text-dark: #1A1A1A;
            --white: #FFFFFF;
        }

        body { margin: 0; font-family: 'Poppins', 'Noto Sans Devanagari', sans-serif; background: var(--bg-light); color: var(--text-dark); line-height: 1.6; }
        
        /* Header */
        header { background: var(--primary-color); padding: 15px 5%; position: sticky; top: 0; z-index: 1000; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; box-shadow: 0 4px 10px rgba(0,0,0,0.2); }
        header .logo img { height: 70px; background: white; padding: 5px; border-radius: 8px; }
        nav { display: flex; gap: 20px; }
        nav a { color: var(--white); text-decoration: none; font-size: 16px; font-weight: 500; transition: color 0.3s; }
        nav a:hover { color: var(--accent-color); }

        /* Sections */
        section { padding: 80px 20px; max-width: 1200px; margin: auto; }
        .secondary { background: var(--white); border-radius: 20px; padding: 60px 40px; box-shadow: 0 5px 20px rgba(0,0,0,0.05); }
        
        h1, h2, h3 { color: var(--primary-color); margin-bottom: 20px; }
        h2 { text-align: center; font-size: 2.2rem; position: relative; margin-bottom: 50px; }
        h2::after { content: ''; display: block; width: 80px; height: 5px; background: var(--accent-color); margin: 15px auto 0; border-radius: 3px; }

        /* Hero */
        .hero { 
            text-align: center; padding: 140px 20px; 
            background: linear-gradient(135deg, rgba(0, 51, 102, 0.9), rgba(0, 51, 102, 0.7)), url('lab4.jpeg'); 
            background-size: cover; background-position: center; 
            color: white; border-radius: 0 0 30px 30px; 
        }
        .hero h1 { font-size: 2.5rem; text-shadow: 2px 2px 5px rgba(0,0,0,0.6); }

        /* Courses */
        .courses { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px; }
        .course { background: var(--white); border-radius: 18px; padding: 20px; text-align: center; box-shadow: 0 10px 25px rgba(0,0,0,0.07); transition: transform 0.3s; }
        .course:hover { transform: translateY(-8px); }
        .course img { width: 100%; height: 260px; object-fit: contain; border-radius: 10px; margin-bottom: 15px; background: #fafafa; }
        .course h3 { font-size: 1.2rem; font-weight: 700; }

        /* Gallery */
        .gallery-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; }
        .gallery-item img { width: 100%; height: 220px; object-fit: cover; border-radius: 12px; transition: transform 0.3s; }
        .gallery-item img:hover { transform: scale(1.05); }

        /* Contact */
        .contact-container { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
        .contact-info { text-align: center; background: white; padding: 30px; border-radius: 20px; box-shadow: 0 5px 20px rgba(0,0,0,0.05); }
        .contact-icons { margin: 20px 0; display: flex; justify-content: center; gap: 15px; }
        .contact-icons img { width: 40px; height: 40px; transition: transform 0.2s; }
        .contact-icons img:hover { transform: scale(1.1); }
        
        iframe { width: 100%; height: 300px; border: 0; border-radius: 15px; margin-top: 20px; }

        form { background: var(--white); padding: 30px; border-radius: 20px; box-shadow: 0 5px 20px rgba(0,0,0,0.05); }
        input, select, textarea { width: 100%; padding: 12px; margin-bottom: 15px; border: 2px solid #eee; border-radius: 8px; box-sizing: border-box; }
        button { width: 100%; background: var(--accent-color); color: white; padding: 14px; border: none; border-radius: 30px; font-weight: 600; cursor: pointer; }

        footer { background: var(--primary-color); color: rgba(255,255,255,0.8); text-align: center; padding: 40px 20px; margin-top: 40px; }

        @media (max-width: 768px) { header { flex-direction: column; gap: 15px; } .contact-container { grid-template-columns: 1fr; } .hero h1 { font-size: 1.8rem; } }
    </style>
</head>

